PORT=3000
NODE_ENV=production

# Database — inside Hamravesh cluster use internal host (NOT external hadb.ir)
DB_HOST=eventio.royaghavami.svc
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=eventio

# Set true on first deploy to create tables, then turn off
DB_SYNCHRONIZE=true

JWT_SECRET=change-me-in-production
# Frontend domain(s) — comma-separated (NOT the API URL)
CORS_ORIGIN=https://eventio.ir,https://pishpish.darkube.ir
EVENT_REQUIRE_ADMIN_APPROVAL=false
